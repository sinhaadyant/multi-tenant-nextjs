# Test Environment Configuration
NODE_ENV=test
PORT=3002

# Test Database Configuration
DATABASE_URL_TEST="mysql://root:password@localhost:3306/test_db"
DATABASE_URL="mysql://root:password@localhost:3306/test_db"

# Redis Configuration (Test)
REDIS_URL=redis://localhost:6379/1

# JWT Configuration (Test)
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-refresh-secret-key-for-testing-only
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration (Test)
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=15
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION=5

# CORS Configuration (Test)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# File Upload Configuration (Test)
UPLOAD_PATH=./test-uploads
MAX_FILE_SIZE=1048576
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf

# Email Configuration (Test)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test-user
SMTP_PASS=test-pass
EMAIL_FROM=test@example.com

# Monitoring and Logging (Test)
LOG_LEVEL=error
LOG_FILE=./test-logs/test.log
ENABLE_REQUEST_LOGGING=false

# Test Configuration
TEST_TIMEOUT=10000
TEST_DATABASE_CLEANUP=true
