# Test Environment Configuration
NODE_ENV=test
PORT=3001
HOST=localhost

# Test Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=multi_tenant_saas_test
DB_NAME_TEST=multi_tenant_saas_test
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=10000
DB_POOL_IDLE=5000

# Test JWT Configuration
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_REFRESH_SECRET=test-refresh-secret-key-for-testing-only
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
JWT_RESET_EXPIRY=1h

# Test CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Test Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Test File Upload
UPLOAD_PATH=./test-uploads
MAX_FILE_SIZE=1048576
ALLOWED_FILE_TYPES=image/jpeg,image/png,text/plain

# Test Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@example.com
SMTP_PASS=test-password
SMTP_FROM=test@example.com

# Test Security
BCRYPT_SALT_ROUNDS=4
SESSION_SECRET=test-session-secret

# Test Logging
LOG_LEVEL=error
LOG_FILE=./test-logs/test.log

# Test API Configuration
API_PREFIX=/api/v1
API_VERSION=1.0.0

# Test Pagination Defaults
DEFAULT_PAGE_SIZE=5
MAX_PAGE_SIZE=10

# Test Audit Logging
AUDIT_LOG_ENABLED=false
AUDIT_LOG_RETENTION_DAYS=1

# Test Tenant Configuration
DEFAULT_MAX_DEVICES=2
DEFAULT_ALLOW_MULTIPLE_SESSIONS=true
DEFAULT_PASSWORD_EXPIRY_DAYS=30
DEFAULT_SESSION_TIMEOUT=1800

# Test Settings
TEST_DB_SYNC=true
TEST_TIMEOUT=10000
TEST_API_URL=http://localhost:3001

# Test Development
ENABLE_SWAGGER=false
ENABLE_LOGGING=false

# Supabase Test Configuration
SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_ANON_KEY=your-test-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# Test External Services
REDIS_URL=redis://localhost:6379
REDIS_TTL=300

# Test Monitoring
ENABLE_METRICS=false
METRICS_PORT=9091
