# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/multi-tenant-scale"

# JWT Configuration
JWT_PRIVATE_KEY_PATH="./jwt-keys/private.key"
JWT_PUBLIC_KEY_PATH="./jwt-keys/public.key"
JWT_SECRET="your-fallback-hmac-secret-key-here"
JWT_ACCESS_TOKEN_EXPIRY="15m"
JWT_REFRESH_TOKEN_EXPIRY="7d"

# Server Configuration
PORT=3001
NODE_ENV=development

# Security
BCRYPT_ROUNDS=12

# File Upload
MAX_FILE_SIZE=10485760 # 10MB in bytes
UPLOAD_PATH="./uploads"

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Redis Configuration
REDIS_URL=redis://localhost:6379

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
