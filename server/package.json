{
  "name": "multi-tenant-admin-api",
  "version": "1.0.0",
  "description": "Multi-tenant admin panel API with comprehensive testing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "node tests/run-e2e-tests.js",
    "test:e2e:auth": "node tests/run-e2e-tests.js --file tests/e2e/auth-fixed.test.js",
    "test:e2e:users": "node tests/run-e2e-tests.js --file tests/e2e/user-management.test.js",
    "test:e2e:roles": "node tests/run-e2e-tests.js --file tests/e2e/role-management.test.js",
    "test:e2e:tenants": "node tests/run-e2e-tests.js --file tests/e2e/tenant-management.test.js",
    "test:e2e:sessions": "node tests/run-e2e-tests.js --file tests/e2e/session-management.test.js",
    "test:e2e:search": "node tests/run-e2e-tests.js --file tests/e2e/search.test.js",
    "test:e2e:analytics": "node tests/run-e2e-tests.js --file tests/e2e/analytics.test.js",
    "test:e2e:notifications": "node tests/run-e2e-tests.js --file tests/e2e/notification.test.js",
    "test:integration": "mocha --require ts-node/register --timeout 10000 tests/integration/**/*.test.ts",
    "test:unit": "jest tests/unit",
    "db:test:setup": "NODE_ENV=test npx prisma migrate reset --force && npx prisma db seed",
    "db:test:clean": "NODE_ENV=test npx prisma migrate reset --force",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@types/archiver": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.8",
    "redis": "^4.6.11",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^4.3.11",
    "@types/chai-http": "^4.2.4",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/faker": "^6.6.6",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mocha": "^10.0.6",
    "@types/multer": "^1.4.11",
    "@types/sinon": "^17.0.3",
    "@types/supertest": "^2.0.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "chai": "^4.3.10",
    "chai-http": "^4.4.0",
    "eslint": "^8.56.0",
    "faker": "^6.6.6",
    "jest": "^29.7.0",
    "jest-util": "^30.0.5",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "sinon": "^17.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
