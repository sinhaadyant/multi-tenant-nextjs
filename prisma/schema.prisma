generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SuperAdmin {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  password            String
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  contactNumber       String?
  avatar              String?
  auditLogs           AuditLog[]
  inviteTokens        InviteToken[]
  notifications       Notification[]
  reports             Report[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]

  @@map("super_admins")
}

model Tenant {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  domain         String?
  description    String?
  isActive       Boolean         @default(true)
  plan           String          @default("starter")
  region         String          @default("US East")
  features       String          @db.LongText
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  metadata       String?         @db.LongText
  auditLogs      AuditLog[]
  notifications  Notification[]
  supportTickets SupportTicket[]
  users          User[]
  roles          Role[]          // Tenant-specific roles
  reports        Report[]

  @@map("tenants")
}

model User {
  id             String          @id @default(cuid())
  email          String
  name           String
  password       String
  isActive       Boolean         @default(true)
  lastLogin      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenantId       String?
  contactNumber  String?
  auditLogs      AuditLog[]
  supportTickets SupportTicket[]
  tenant         Tenant?         @relation(fields: [tenantId], references: [id])
  userRoles      UserRole[]      // Multiple role assignments

  @@unique([email, tenantId])
  @@index([tenantId], map: "users_tenantId_fkey")
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String
  description String?
  isActive    Boolean          @default(true)
  isDefault   Boolean          @default(false)  // Default role for tenant
  isTemplate  Boolean          @default(false)  // Template role from SuperAdmin
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenantId    String?          // null for template roles
  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([name, tenantId])  // Role names unique within tenant
  @@index([tenantId], map: "roles_tenantId_fkey")
  @@map("roles")
}

model Module {
  id              String           @id @default(cuid())
  moduleKey       String           @unique // e.g., "dashboard", "users", "reports"
  moduleName      String           // Display name e.g., "Dashboard", "User Management"
  path            String?          // Frontend route path
  icon            String?          // Icon identifier
  parentModuleKey String?          // For hierarchical menu structure
  parentModule    Module?          @relation("ModuleHierarchy", fields: [parentModuleKey], references: [moduleKey])
  childModules    Module[]         @relation("ModuleHierarchy")
  description     String?
  isActive        Boolean          @default(true)
  isVisible       Boolean          @default(true) // Whether to show in menu
  orderIndex      Int              @default(0) // Menu ordering
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  permissions     Permission[]

  @@map("modules")
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  moduleKey       String           // Reference to Module.moduleKey
  module          Module           @relation(fields: [moduleKey], references: [moduleKey])
  submodule       String?          // e.g., "Analytics", "Management", "News"
  action          String           // e.g., "view", "create", "edit", "delete"
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permissionId_fkey")
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  assignedAt DateTime @default(now())
  assignedBy String?  // Who assigned this role (SuperAdmin or Tenant Admin)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId], map: "user_roles_userId_fkey")
  @@index([roleId], map: "user_roles_roleId_fkey")
  @@map("user_roles")
}

model AuditLog {
  id           String      @id @default(cuid())
  action       String
  details      String?     @db.LongText
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())
  tenantId     String?
  userId       String?
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])
  tenant       Tenant?     @relation(fields: [tenantId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])

  @@index([superAdminId], map: "audit_logs_superAdminId_fkey")
  @@index([tenantId], map: "audit_logs_tenantId_fkey")
  @@index([userId], map: "audit_logs_userId_fkey")
  @@map("audit_logs")
}

model Notification {
  id             String      @id @default(cuid())
  title          String      @db.VarChar(100)
  message        String      @db.Text
  isRead         Boolean     @default(false)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String?
  priority       String      @default("medium")
  targetTenantId String?
  targetType     String      @default("superadmin")
  super_admins   SuperAdmin? @relation(fields: [createdBy], references: [id])
  tenants        Tenant?     @relation(fields: [targetTenantId], references: [id])

  @@index([createdBy], map: "notifications_createdBy_fkey")
  @@index([targetTenantId], map: "notifications_targetTenantId_fkey")
  @@map("notifications")
}

model SupportTicket {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  description String   @db.Text
  category    String   @default("general")
  status      String   @default("open")
  priority    String   @default("medium")
  isForwarded Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String?
  userId      String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
  comments    SupportTicketComment[]
  attachments SupportTicketAttachment[]

  @@index([tenantId], map: "support_tickets_tenantId_fkey")
  @@index([userId], map: "support_tickets_userId_fkey")
  @@index([status], map: "support_tickets_status_fkey")
  @@index([priority], map: "support_tickets_priority_fkey")
  @@index([category], map: "support_tickets_category_fkey")
  @@map("support_tickets")
}

model SupportTicketComment {
  id          String        @id @default(cuid())
  text        String        @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  ticketId    String
  commentedBy String        // Can be userId, tenantId, or superAdminId
  commenterType String      // "user", "tenant", "superadmin"
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments SupportTicketCommentAttachment[]

  @@index([ticketId], map: "support_ticket_comments_ticketId_fkey")
  @@index([commentedBy], map: "support_ticket_comments_commentedBy_fkey")
  @@map("support_ticket_comments")
}

model SupportTicketAttachment {
  id          String        @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  path        String
  createdAt   DateTime      @default(now())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId], map: "support_ticket_attachments_ticketId_fkey")
  @@map("support_ticket_attachments")
}

model SupportTicketCommentAttachment {
  id          String                @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  path        String
  createdAt   DateTime              @default(now())
  commentId   String
  comment     SupportTicketComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId], map: "support_ticket_comment_attachments_commentId_fkey")
  @@map("support_ticket_comment_attachments")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model InviteToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  type      String   // "tenant", "user", "superadmin"
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])

  @@index([superAdminId], map: "invite_tokens_superAdminId_fkey")
  @@map("invite_tokens")
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   // "info", "warn", "error"
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("system_logs")
}

model Report {
  id          String      @id @default(cuid())
  name        String
  type        String      // "analytics", "audit", "system"
  data        String      @db.LongText
  createdAt   DateTime    @default(now())
  tenantId    String?
  superAdminId String?
  tenant      Tenant?     @relation(fields: [tenantId], references: [id])
  superAdmin  SuperAdmin? @relation(fields: [superAdminId], references: [id])

  @@index([tenantId], map: "reports_tenantId_fkey")
  @@index([superAdminId], map: "reports_superAdminId_fkey")
  @@map("reports")
}

model PasswordResetToken {
  id           String      @id @default(cuid())
  token        String      @unique
  email        String
  expiresAt    DateTime
  used         Boolean     @default(false)
  type         String      @default("superadmin") // "superadmin" or "tenant"
  createdAt    DateTime    @default(now())
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])

  @@index([email], map: "password_reset_tokens_email_idx")
  @@index([superAdminId], map: "password_reset_tokens_superAdminId_fkey")
  @@map("password_reset_tokens")
}

model RefreshToken {
  id           String      @id @default(cuid())
  tokenId      String      @unique // Unique identifier for the token pair
  hashedToken  String      @unique // Hashed refresh token for security
  superAdminId String
  superAdmin   SuperAdmin  @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  isRevoked    Boolean     @default(false)
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  lastUsedAt   DateTime?
  deviceInfo   String?     // User agent, device fingerprint
  ipAddress    String?     // IP address where token was issued
  
  @@index([superAdminId], map: "refresh_tokens_superAdminId_fkey")
  @@index([tokenId], map: "refresh_tokens_tokenId_idx")
  @@index([expiresAt], map: "refresh_tokens_expiresAt_idx")
  @@map("refresh_tokens")
}
