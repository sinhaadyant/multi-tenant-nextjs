generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SuperAdmin {
  id                    String               @id @default(cuid())
  email                 String               @unique
  name                  String
  password              String
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  contactNumber         String?
  avatar                String?
  auditLogs             AuditLog[]
  backups               Backup[]
  inviteTokens          InviteToken[]
  createdMenuItems      MenuItem[]           @relation("MenuItemCreatedBy")
  updatedMenuItems      MenuItem[]           @relation("MenuItemUpdatedBy")
  notifications         Notification[]
  passwordResetTokens   PasswordResetToken[]
  refreshTokens         RefreshToken[]
  reports               Report[]
  createdSupportTickets SupportTicket[]

  @@map("super_admins")
}

model Tenant {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  domain            String?
  description       String?
  isActive          Boolean            @default(true)
  plan              String             @default("starter")
  region            String             @default("US East")
  features          String             @db.LongText
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  metadata          String?            @db.LongText
  auditLogs         AuditLog[]
  notifications     Notification[]
  reports           Report[]
  roles             Role[]
  supportTickets    SupportTicket[]
  tenantModules     TenantModule[]
  userInvitations   UserInvitation[]
  userNotifications UserNotification[]
  users             User[]

  @@map("tenants")
}

model User {
  id                String             @id @default(cuid())
  email             String
  name              String
  password          String
  isActive          Boolean            @default(true)
  lastLogin         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenantId          String?
  contactNumber     String?
  auditLogs         AuditLog[]
  supportTickets    SupportTicket[]
  userNotifications UserNotification[]
  userRoles         UserRole[]
  sentInvitations   UserInvitation[]   @relation("UserInvitationInviter")
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])

  @@unique([email, tenantId])
  @@index([tenantId], map: "users_tenantId_fkey")
  @@map("users")
}

model UserInvitation {
  id          String    @id @default(cuid())
  email       String
  name        String
  tenantId    String
  roleId      String
  invitedById String
  token       String    @unique
  expiresAt   DateTime
  message     String?   @db.Text
  status      String    @default("pending") // pending, accepted, expired, cancelled
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  acceptedAt  DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("UserInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "user_invitations_tenantId_fkey")
  @@index([roleId], map: "user_invitations_roleId_fkey")
  @@index([invitedById], map: "user_invitations_invitedById_fkey")
  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@map("user_invitations")
}

model Role {
  id          String           @id @default(cuid())
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  isDefault   Boolean          @default(false)
  isTemplate  Boolean          @default(false)
  tenantId    String?
  color       String?
  createdBy   String?
  isSystem    Boolean          @default(false)
  priority    Int              @default(0)
  isGlobal    Boolean          @default(false)
  permissions     RolePermission[]
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  userInvitations UserInvitation[]
  userRoles       UserRole[]

  @@unique([name, isGlobal])
  @@index([tenantId], map: "roles_tenantId_fkey")
  @@index([isGlobal], map: "roles_isGlobal_fkey")
  @@index([isActive])
  @@index([isTemplate])
  @@map("roles")
}

model Module {
  id              String           @id @default(cuid())
  moduleKey       String           @unique
  moduleName      String
  path            String?
  icon            String?
  parentModuleKey String?
  description     String?
  isActive        Boolean          @default(true)
  isVisible       Boolean          @default(true)
  orderIndex      Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  maxVersion      String?
  minVersion      String?
  releaseNotes    String?          @db.Text
  version         String?
  parentModule    Module?          @relation("ModuleHierarchy", fields: [parentModuleKey], references: [moduleKey])
  childModules    Module[]         @relation("ModuleHierarchy")
  rolePermissions RolePermission[]
  tenantModules   TenantModule[]

  @@index([parentModuleKey], map: "modules_parentModuleKey_fkey")
  @@map("modules")
}

model TenantModule {
  id             String    @id @default(cuid())
  tenantId       String
  moduleKey      String
  isEnabled      Boolean   @default(true)
  isVisible      Boolean   @default(true)
  version        String?
  settings       String?   @db.LongText
  enabledAt      DateTime?
  disabledAt     DateTime?
  enabledBy      String?
  disabledBy     String?
  lastAccessedAt DateTime?
  accessCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  module         Module    @relation(fields: [moduleKey], references: [moduleKey], onDelete: Cascade)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId], map: "tenant_modules_tenantId_fkey")
  @@index([moduleKey], map: "tenant_modules_moduleKey_fkey")
  @@index([isEnabled])
  @@map("tenant_modules")
}

model RolePermission {
  id         String  @id @default(cuid())
  roleId     String
  canCreate  Boolean @default(false)
  canDelete  Boolean @default(false)
  canRead    Boolean @default(false)
  canUpdate  Boolean @default(false)
  canViewAll Boolean @default(false)
  moduleKey  String
  module     Module  @relation(fields: [moduleKey], references: [moduleKey], onDelete: Cascade)
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleKey])
  @@index([moduleKey], map: "role_permissions_moduleKey_fkey")
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId], map: "user_roles_userId_fkey")
  @@index([roleId], map: "user_roles_roleId_fkey")
  @@map("user_roles")
}

model AuditLog {
  id              String      @id @default(cuid())
  action          String
  details         String?     @db.LongText
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime    @default(now())
  tenantId        String?
  userId          String?
  superAdminId    String?
  archivedAt      DateTime?
  isArchived      Boolean     @default(false)
  newValues       String?     @db.LongText
  oldValues       String?     @db.LongText
  requestId       String?
  resourceId      String?
  resourceType    String?
  retentionExpiry DateTime?
  sessionId       String?
  severity        String      @default("info")
  status          String      @default("success")
  superAdmin      SuperAdmin? @relation(fields: [superAdminId], references: [id])
  tenant          Tenant?     @relation(fields: [tenantId], references: [id])
  user            User?       @relation(fields: [userId], references: [id])

  @@index([superAdminId], map: "audit_logs_superAdminId_fkey")
  @@index([tenantId], map: "audit_logs_tenantId_fkey")
  @@index([userId], map: "audit_logs_userId_fkey")
  @@index([status], map: "audit_logs_status_fkey")
  @@index([severity], map: "audit_logs_severity_fkey")
  @@index([resourceType], map: "audit_logs_resourceType_fkey")
  @@index([createdAt], map: "audit_logs_createdAt_fkey")
  @@index([isArchived], map: "audit_logs_isArchived_fkey")
  @@index([retentionExpiry], map: "audit_logs_retentionExpiry_fkey")
  @@map("audit_logs")
}

model Notification {
  id                String             @id @default(cuid())
  title             String             @db.VarChar(255)
  message           String             @db.Text
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  priority          String             @default("medium")
  targetTenantId    String?
  targetType        String             @default("superadmin")
  attachments       String?            @db.Text
  createdByType     String             @default("superadmin")
  metadata          String?            @db.Text
  scheduledAt       DateTime?
  sentAt            DateTime?
  status            String             @default("draft")
  type              String             @default("info")
  superAdmin        SuperAdmin?        @relation(fields: [createdBy], references: [id])
  tenant            Tenant?            @relation(fields: [targetTenantId], references: [id])
  userNotifications UserNotification[]

  @@index([createdBy], map: "notifications_createdBy_fkey")
  @@index([targetTenantId], map: "notifications_targetTenantId_fkey")
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
  @@map("notifications")
}

model UserNotification {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  tenantId       String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  tenant         Tenant?      @relation(fields: [tenantId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId], map: "user_notifications_userId_fkey")
  @@index([notificationId], map: "user_notifications_notificationId_fkey")
  @@index([tenantId], map: "user_notifications_tenantId_fkey")
  @@index([isRead])
  @@index([createdAt])
  @@map("user_notifications")
}

model SupportTicket {
  id                  String                    @id @default(cuid())
  description         String                    @db.Text
  status              String                    @default("open")
  priority            String                    @default("medium")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tenantId            String?
  userId              String?
  category            String                    @default("general")
  isForwarded         Boolean                   @default(false)
  title               String                    @db.VarChar(255)
  createdBy           String?
  createdByType       String                    @default("user")
  attachments         SupportTicketAttachment[]
  comments            SupportTicketComment[]
  createdBySuperAdmin SuperAdmin?               @relation(fields: [createdBy], references: [id])
  tenant              Tenant?                   @relation(fields: [tenantId], references: [id])
  user                User?                     @relation(fields: [userId], references: [id])

  @@index([tenantId], map: "support_tickets_tenantId_fkey")
  @@index([userId], map: "support_tickets_userId_fkey")
  @@index([createdBy], map: "support_tickets_createdBy_fkey")
  @@index([status], map: "support_tickets_status_fkey")
  @@index([priority], map: "support_tickets_priority_fkey")
  @@index([category], map: "support_tickets_category_fkey")
  @@map("support_tickets")
}

model SupportTicketComment {
  id            String                           @id @default(cuid())
  text          String                           @db.Text
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt
  ticketId      String
  commentedBy   String
  commenterType String
  attachments   SupportTicketCommentAttachment[]
  ticket        SupportTicket                    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId], map: "support_ticket_comments_ticketId_fkey")
  @@index([commentedBy], map: "support_ticket_comments_commentedBy_fkey")
  @@map("support_ticket_comments")
}

model SupportTicketAttachment {
  id           String        @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime      @default(now())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId], map: "support_ticket_attachments_ticketId_fkey")
  @@map("support_ticket_attachments")
}

model SupportTicketCommentAttachment {
  id           String               @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime             @default(now())
  commentId    String
  comment      SupportTicketComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId], map: "support_ticket_comment_attachments_commentId_fkey")
  @@map("support_ticket_comment_attachments")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model InviteToken {
  id           String      @id @default(cuid())
  token        String      @unique
  email        String
  isUsed       Boolean     @default(false)
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  superAdminId String?
  type         String
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])

  @@index([superAdminId], map: "invite_tokens_superAdminId_fkey")
  @@map("invite_tokens")
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("system_logs")
}

model Report {
  id           String      @id @default(cuid())
  tenantId     String?
  createdAt    DateTime    @default(now())
  data         String      @db.LongText
  name         String
  superAdminId String?
  type         String
  status       String      @default("generating")
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])
  tenant       Tenant?     @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "reports_tenantId_fkey")
  @@index([superAdminId], map: "reports_superAdminId_fkey")
  @@index([status])
  @@map("reports")
}

model PasswordResetToken {
  id           String      @id @default(cuid())
  token        String      @unique
  email        String
  expiresAt    DateTime
  used         Boolean     @default(false)
  createdAt    DateTime    @default(now())
  superAdminId String?
  type         String      @default("superadmin")
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])

  @@index([email])
  @@index([superAdminId], map: "password_reset_tokens_superAdminId_fkey")
  @@map("password_reset_tokens")
}

model RefreshToken {
  id           String     @id @default(cuid())
  tokenId      String     @unique
  hashedToken  String     @unique
  superAdminId String
  isRevoked    Boolean    @default(false)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  lastUsedAt   DateTime?
  deviceInfo   String?
  ipAddress    String?
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([superAdminId], map: "refresh_tokens_superAdminId_fkey")
  @@index([tokenId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Backup {
  id          String     @id @default(cuid())
  filename    String
  status      String     @default("processing")
  fileSize    Int        @default(0)
  duration    Int        @default(0)
  description String?
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  createdById String
  options     String?    @db.LongText
  filePath    String?
  createdBy   SuperAdmin @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById], map: "backups_createdById_fkey")
  @@index([status])
  @@index([createdAt])
  @@map("backups")
}

model MenuItem {
  id                  String      @id @default(cuid())
  label               String
  path                String?
  icon                String?
  order               Int         @default(0)
  isActive            Boolean     @default(true)
  parentId            String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  createdBy           String?
  updatedBy           String?
  createdBySuperAdmin SuperAdmin? @relation("MenuItemCreatedBy", fields: [createdBy], references: [id])
  parent              MenuItem?   @relation("MenuItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children            MenuItem[]  @relation("MenuItemHierarchy")
  updatedBySuperAdmin SuperAdmin? @relation("MenuItemUpdatedBy", fields: [updatedBy], references: [id])

  @@index([parentId], map: "menu_items_parentId_fkey")
  @@index([order])
  @@index([isActive])
  @@index([createdBy], map: "menu_items_createdBy_fkey")
  @@index([updatedBy], map: "menu_items_updatedBy_fkey")
  @@map("menu_items")
}
