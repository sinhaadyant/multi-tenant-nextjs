      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-set authentication headers based on the request",
          "if (pm.request.url.path.includes('superadmin')) {",
          "    pm.request.headers.add({",
          "        key: 'Authorization',",
          "        value: 'Bearer ' + pm.collectionVariables.get('superadminToken')",
          "    });",
          "} else if (pm.request.url.path.includes('tenant')) {",
          "    pm.request.headers.add({",
          "        key: 'Authorization',",
          "        value: 'Bearer ' + pm.collectionVariables.get('tenantToken')",
          "    });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-save tokens from login responses",
          "if (pm.response.code === 200) {",
          "    const response = pm.response.json();",
          "    if (response.token) {",
          "        if (pm.request.url.path.includes('superadmin')) {",
          "            pm.collectionVariables.set('superadminToken', response.token);",
          "        } else {",
          "            pm.collectionVariables.set('tenantToken', response.token);",
          "        }",
          "    }",
          "}",
          "",
          "// Log response for debugging",
          "console.log('Response Status:', pm.response.status);",
          "console.log('Response Time:', pm.response.responseTime + 'ms');"
        ]
      }
    }
